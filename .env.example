# Google OAuth (next-auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Backend API (Express service in app.js)
NEXT_PUBLIC_API_BASE=http://localhost:8080
PROJECT_ID=

# Shared secret between the Next.js server and the Express backend.
# Must match on both sides. Only the Next.js server (which enforces RBAC)
# should ever send this — never expose it to the browser.
INTERNAL_API_KEY=
